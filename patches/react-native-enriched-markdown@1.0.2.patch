@@ -106,8 +111,38 @@
     }
     yOffset += rowHeight;
   }
+
+  [self drawHorizontalRules];
 }
 
+// Yohaku patch: 三线表 — the table is set as printed type, not as a grid. No
+// vertical rules at all; a heavy rule opens and closes the block, a hairline
+// separates the header and each body row.
+- (void)drawHorizontalRules
+{
+  CGFloat totalWidth = 0;
+  for (NSNumber *width in _columnWidths) {
+    totalWidth += width.doubleValue;
+  }
+  if (totalWidth <= 0 || !_borderColor)
+    return;
+
+  UIColor *hairline = [_borderColor colorWithAlphaComponent:kENRMTableHairlineAlpha];
+  CGFloat strongWidth = _borderWidth * 2;
+
+  CGFloat y = 0;
+  ENRMTableDrawRule(0, totalWidth, strongWidth, _borderColor);
+  for (NSUInteger r = 0; r < _rowHeights.count; r++) {
+    y += [_rowHeights[r] doubleValue];
+    BOOL isLast = (r == _rowHeights.count - 1);
+    if (isLast) {
+      ENRMTableDrawRule(y - strongWidth, totalWidth, strongWidth, _borderColor);
+    } else {
+      ENRMTableDrawRule(y, totalWidth, _borderWidth, hairline);
+    }
+  }
+}
