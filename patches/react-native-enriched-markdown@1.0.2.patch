 #pragma mark - Drawing
 
+// Yohaku patch: row separators are the border color at reduced alpha, so a
+// single `borderColor` still drives both the heavy and the hairline rule.
+static const CGFloat kENRMTableHairlineAlpha = 0.32;
+
+static void ENRMTableDrawRule(CGFloat y, CGFloat width, CGFloat thickness, UIColor *color)
+{
+  [color setFill];
+  UIRectFill(CGRectMake(0, y, width, thickness));
+}
