+static const CGFloat kENRMTableHeaderKernRatio = 0.16;
+
+static CGFloat ENRMTableHeaderFontSize(StyleConfig *config)
+{
+  return MAX(config.tableFontSize * kENRMTableHeaderFontScale, kENRMTableHeaderMinFontSize);
+}
