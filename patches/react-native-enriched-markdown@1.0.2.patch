+#import "ENRMMarkdownASTExport.h"
+#include "MD4CParser.hpp"
+#include "MarkdownASTNode.hpp"
+
+static NSString *ENRMNodeTypeName(Markdown::NodeType type)
+{
+  switch (type) {
+    case Markdown::NodeType::Document:
+      return @"document";
+    case Markdown::NodeType::Paragraph:
+      return @"paragraph";
+    case Markdown::NodeType::Text:
+      return @"text";
+    case Markdown::NodeType::Link:
+      return @"link";
+    case Markdown::NodeType::Heading:
+      return @"heading";
+    case Markdown::NodeType::LineBreak:
+      return @"lineBreak";
+    case Markdown::NodeType::Strong:
+      return @"strong";
+    case Markdown::NodeType::Emphasis:
+      return @"emphasis";
+    case Markdown::NodeType::Strikethrough:
+      return @"strikethrough";
+    case Markdown::NodeType::Underline:
+      return @"underline";
+    case Markdown::NodeType::Code:
+      return @"code";
+    case Markdown::NodeType::Image:
+      return @"image";
+    case Markdown::NodeType::Blockquote:
+      return @"blockquote";
+    case Markdown::NodeType::UnorderedList:
+      return @"unorderedList";
+    case Markdown::NodeType::OrderedList:
+      return @"orderedList";
+    case Markdown::NodeType::ListItem:
+      return @"listItem";
+    case Markdown::NodeType::CodeBlock:
+      return @"codeBlock";
+    case Markdown::NodeType::ThematicBreak:
+      return @"thematicBreak";
+    case Markdown::NodeType::Table:
+      return @"table";
+    case Markdown::NodeType::TableHead:
+      return @"tableHead";
+    case Markdown::NodeType::TableBody:
+      return @"tableBody";
+    case Markdown::NodeType::TableRow:
+      return @"tableRow";
+    case Markdown::NodeType::TableHeaderCell:
+      return @"tableHeaderCell";
+    case Markdown::NodeType::TableCell:
+      return @"tableCell";
+    case Markdown::NodeType::LatexMathInline:
+      return @"latexMathInline";
+    case Markdown::NodeType::LatexMathDisplay:
+      return @"latexMathDisplay";
+    case Markdown::NodeType::Spoiler:
+      return @"spoiler";
+    case Markdown::NodeType::Superscript:
+      return @"superscript";
+    case Markdown::NodeType::Subscript:
+      return @"subscript";
+    case Markdown::NodeType::Highlight:
+      return @"highlight";
+    case Markdown::NodeType::SoftBreak:
+      return @"softBreak";
+  }
+  return @"text";
+}
+
+static NSString *ENRMString(const std::string &value)
+{
+  return [NSString stringWithUTF8String:value.c_str()] ?: @"";
+}
+
+static NSDictionary *ENRMExportNode(const Markdown::MarkdownASTNode &node)
+{
+  NSMutableDictionary *out = [NSMutableDictionary dictionaryWithObject:ENRMNodeTypeName(node.type) forKey:@"type"];
+  if (!node.content.empty()) {
+    out[@"content"] = ENRMString(node.content);
+  }
+  if (!node.attributes.empty()) {
+    NSMutableDictionary *attributes = [NSMutableDictionary dictionaryWithCapacity:node.attributes.size()];
+    for (const auto &entry : node.attributes) {
+      attributes[ENRMString(entry.first)] = ENRMString(entry.second);
+    }
+    out[@"attributes"] = attributes;
+  }
+  if (!node.children.empty()) {
+    NSMutableArray *children = [NSMutableArray arrayWithCapacity:node.children.size()];
+    for (const auto &child : node.children) {
+      if (child) {
+        [children addObject:ENRMExportNode(*child)];
+      }
+    }
+    out[@"children"] = children;
+  }
+  return out;
+}
+
+@implementation ENRMMarkdownASTExport
+
++ (NSString *)jsonForMarkdown:(NSString *)markdown
+{
+  const char *utf8 = markdown.UTF8String;
+  Markdown::Md4cFlags flags;
+  flags.highlight = true;
+  Markdown::MD4CParser parser;
+  auto root = parser.parse(utf8 ? std::string(utf8) : std::string(), flags);
+  NSData *data = root ? [NSJSONSerialization dataWithJSONObject:ENRMExportNode(*root) options:0 error:nil] : nil;
+  NSString *json = data ? [[NSString alloc] initWithData:data encoding:NSUTF8StringEncoding] : nil;
+  return json ?: @"{\"type\":\"document\"}";
+}
+
+@end
