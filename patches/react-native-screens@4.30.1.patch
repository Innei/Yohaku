                                       withProvider:self];
 }
 
@@ -1422,6 +1435,7 @@ - (void)finalizeUpdates:(RNComponentViewUpdateMask)updateMask
 {
   [super finalizeUpdates:updateMask];
   if (_shouldUpdateScrollEdgeEffects) {
