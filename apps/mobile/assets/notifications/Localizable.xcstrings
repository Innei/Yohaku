    "PUSH_REPLY_BODY": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Your comment on “%@” received a reply." } },
        "ja": { "stringUnit": { "state": "translated", "value": "「%@」へのコメントに返信がありました。" } },
