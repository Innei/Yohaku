{
  "name": "@yohaku/mobile",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "prebuild:css": "pnpm --filter @yohaku/rich-content build:css",
    "prestart": "pnpm prebuild:css",
    "preios": "pnpm prebuild:css",
    "eas-build-post-install": "pnpm prebuild:css",
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "ota:update": "bun ../../../expo-ota/apps/easc/bin/easc.js update --channel production --non-interactive",
    "lint": "expo lint",
    "test": "vitest run"
  },
  "enriched-markdown": {
    "enableCodeHighlight": false,
    "enableMath": false
  },
  "expo": {
    "autolinking": {
      "exclude": [
        "expo-file-system"
      ],
      "ios": {
        "buildFromSource": [
          "expo-image"
        ]
      }
    }
  },
  "dependencies": {
    "@bacons/apple-targets": "^5.0.0",
    "@better-auth/expo": "1.6.26",
    "@expo-google-fonts/noto-serif-sc": "0.4.3",
    "@expo/dom-webview": "workspace:*",
    "@haklex/rich-compose": "0.46.3",
    "@haklex/rich-editor": "0.46.3",
    "@haklex/rich-ext-chat": "0.46.3",
    "@haklex/rich-ext-embed": "0.46.3",
    "@haklex/rich-ext-nested-doc": "0.46.3",
    "@icons-pack/react-simple-icons": "13.15.1",
    "@lexical/react": "0.52.0",
    "@mx-space/ws-client": "^0.1.0",
    "@react-native-menu/menu": "^2.0.0",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/react-query": "5.104.0",
    "@yohaku/design-system": "workspace:*",
    "@yohaku/rich-content": "workspace:*",
    "better-auth": "1.6.26",
    "clsx": "2.1.1",
    "drizzle-orm": "^0.45.3",
    "exif-js": "2.3.0",
    "expo": "~57.0.26",
    "expo-asset": "~57.0.18",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
