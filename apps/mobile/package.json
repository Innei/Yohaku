{
  "name": "@yohaku/mobile",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "prebuild:css": "pnpm --filter @yohaku/rich-content build:css",
    "prestart": "pnpm prebuild:css",
    "preios": "pnpm prebuild:css",
    "eas-build-post-install": "pnpm prebuild:css",
    "start": "expo start",
    "ios": "expo run:ios",
    "ota:update": "bun ../../../expo-ota/apps/easc/bin/easc.js update --channel production --non-interactive",
    "lint": "expo lint",
    "test": "vitest run"
  },
  "enriched-markdown": {
    "enableCodeHighlight": false,
    "enableMath": false
  },
  "expo": {
    "autolinking": {
      "exclude": [
        "expo-file-system"
      ],
      "ios": {
        "buildFromSource": [
          "expo-image"
        ]
      }
    }
  },
  "dependencies": {
    "@bacons/apple-targets": "^5.0.0",
    "@better-auth/expo": "1.6.26",
    "@expo-google-fonts/noto-serif-sc": "0.4.3",
