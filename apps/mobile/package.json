{
  "name": "@yohaku/mobile",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "prebuild:css": "pnpm --filter @yohaku/rich-content build:css",
    "prestart": "pnpm prebuild:css",
    "preios": "pnpm prebuild:css",
    "eas-build-post-install": "pnpm prebuild:css",
    "start": "NODE_OPTIONS=--disable-warning=ExperimentalWarning EXPO_NO_TYPESCRIPT_SETUP=1 expo start --dev-client",
    "ios": "NODE_OPTIONS=--disable-warning=ExperimentalWarning EXPO_NO_TYPESCRIPT_SETUP=1 expo run:ios",
    "ota:update": "bun ../../../expo-ota/apps/easc/bin/easc.js update --channel production --non-interactive",
    "test": "vitest run"
  },
  "enriched-markdown": {
    "enableCodeHighlight": false,
    "enableMath": false
  },
  "expo": {
    "autolinking": {
      "exclude": [
        "expo-file-system"
      ],
      "ios": {
        "buildFromSource": [
          "expo-image"
        ]
      }
    }
  },
  "dependencies": {
    "@bacons/apple-targets": "^5.0.0",
    "@better-auth/expo": "1.7.16",
    "@expo-google-fonts/noto-serif-sc": "0.4.4",
    "@expo/dom-webview": "workspace:*",
    "@haklex/rich-compose": "0.65.7",
    "@haklex/rich-editor": "0.65.7",
    "@haklex/rich-ext-chat": "0.65.7",
    "@haklex/rich-ext-dynamic": "0.65.7",
    "@haklex/rich-ext-embed": "0.65.7",
    "@haklex/rich-ext-nested-doc": "0.65.7",
    "@icons-pack/react-simple-icons": "13.15.1",
    "@lexical/react": "0.53.0",
    "@mx-space/ws-client": "^0.2.0",
    "@react-native-menu/menu": "^2.0.0",
    "@shopify/flash-list": "2.3.3",
    "@tanstack/react-query": "5.104.4",
    "@yohaku/design-system": "workspace:*",
    "@yohaku/rich-content": "workspace:*",
    "better-auth": "1.7.16",
    "clsx": "2.1.1",
    "drizzle-orm": "^0.45.4",
    "exif-js": "2.3.0",
    "expo": "~58.0.23",
    "expo-asset": "~58.0.20",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image": "58.0.16",
    "expo-linking": "~58.0.16",
    "expo-localization": "~58.0.5",
    "expo-modules-core": "~58.0.30",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.21",
    "jsondiffpatch": "^0.7.7",
    "katex": "0.19.0",
    "lexical": "0.53.0",
    "lucide-react": "1.59.0",
    "lumeo": "^0.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.1",
    "react-native-enriched-markdown": "^1.0.2",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
