    "@react-native-menu/menu": "^2.0.0",
    "@shikijs/core": "4.4.3",
    "@tanstack/react-query": "5.101.4",
    "@yohaku/design-system": "workspace:*",
    "@yohaku/rich-content": "workspace:*",
    "better-auth": "1.6.26",
    "clsx": "2.1.1",
    "drizzle-orm": "^0.45.2",
    "exif-js": "2.3.0",
    "expo": "~57.0.18",
    "expo-asset": "~57.0.15",
    "expo-build-properties": "~57.0.15",
