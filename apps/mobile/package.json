    "expo-updates": "~57.0.24",
    "jsondiffpatch": "^0.7.6",
    "katex": "0.18.9",
    "lexical": "0.52.0",
    "lucide-react": "1.49.0",
    "lumeo": "^0.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
