# Attach this probe to a debuggable iOS Simulator process:
# rtk xcrun lldb -p <pid> -b -s apps/mobile/tools/ios-navigation-probe.lldb
#
# The result is an NSDictionary so LLDB can print it without printf or
# variadic Objective-C calls. Private UIKit class names are observed only as
# strings; the app neither links nor sends messages to private UIKit classes.
settings set target.language objc++
expression -l objc++ -O -- ({ UIWindow *probeWindow = nil; UIApplication *probeApplication = (UIApplication *)[UIApplication sharedApplication]; for (UIScene *probeScene in probeApplication.connectedScenes) { if ([probeScene isKindOfClass:[UIWindowScene class]]) { for (UIWindow *candidateWindow in ((UIWindowScene *)probeScene).windows) { if (candidateWindow.isKeyWindow) { probeWindow = candidateWindow; break; } } } } NSMutableDictionary *probeReport = [NSMutableDictionary dictionary]; [probeReport setObject:@"NAV_PROBE_V3" forKey:@"probe"]; [probeReport setObject:(probeWindow ? (NSString *)NSStringFromClass([probeWindow.rootViewController class]) : @"nil") forKey:@"rootViewController"]; [probeReport setObject:((NSString *)[[UIDevice currentDevice] systemVersion]) forKey:@"systemVersion"]; NSMutableArray *probeViews = [NSMutableArray array]; NSMutableArray *probeNavigationBars = [NSMutableArray array]; NSMutableArray *probeScrollViews = [NSMutableArray array]; NSMutableArray *probeQueue = probeWindow ? [NSMutableArray arrayWithObject:probeWindow] : [NSMutableArray array]; while (probeQueue.count > 0) { UIView *probeView = (UIView *)probeQueue.firstObject; [probeQueue removeObjectAtIndex:0]; NSString *probeClass = (NSString *)NSStringFromClass([probeView class]); CALayer *probeMask = probeView.layer.mask; BOOL probeRelevant = [probeClass containsString:@"NavigationBar"] || [probeClass containsString:@"BarBackground"] || [probeClass containsString:@"Platter"] || [probeClass containsString:@"FloatingBar"] || [probeClass containsString:@"Glass"] || [probeClass containsString:@"VisualEffect"] || [probeClass containsString:@"ScrollEdge"] || probeMask != nil; if (probeRelevant) { NSMutableDictionary *probeRow = [NSMutableDictionary dictionary]; [probeRow setObject:probeClass forKey:@"class"]; [probeRow setObject:(NSString *)NSStringFromCGRect(probeView.frame) forKey:@"frame"]; [probeRow setObject:(probeMask ? (NSString *)NSStringFromClass([probeMask class]) : @"none") forKey:@"layerMask"]; [probeRow setObject:[NSNumber numberWithUnsignedInteger:[((NSArray *)probeView.interactions) count]] forKey:@"interactionCount"]; [probeRow setObject:[NSNumber numberWithDouble:probeView.alpha] forKey:@"alpha"]; [probeRow setObject:[NSNumber numberWithBool:[probeView isHidden]] forKey:@"hidden"]; [probeRow setObject:(probeView.backgroundColor ? (NSString *)[probeView.backgroundColor description] : @"none") forKey:@"backgroundColor"]; if ([probeView isKindOfClass:[UIVisualEffectView class]]) { UIVisualEffect *probeEffect = ((UIVisualEffectView *)probeView).effect; [probeRow setObject:(probeEffect ? (NSString *)NSStringFromClass([probeEffect class]) : @"none") forKey:@"effectClass"]; if (@available(iOS 26.0, *)) { if ([probeEffect isKindOfClass:[UIGlassEffect class]]) { UIGlassEffect *probeGlass = (UIGlassEffect *)probeEffect; [probeRow setObject:(probeGlass.tintColor ? (NSString *)[probeGlass.tintColor description] : @"system") forKey:@"glassTintColor"]; } } } [probeViews addObject:probeRow]; } if ([probeView isKindOfClass:[UINavigationBar class]]) { UINavigationBar *probeBar = (UINavigationBar *)probeView; UINavigationBarAppearance *probeStandard = probeBar.topItem.standardAppearance ?: probeBar.standardAppearance; UINavigationBarAppearance *probeScrollEdge = probeBar.topItem.scrollEdgeAppearance ?: probeBar.scrollEdgeAppearance; NSMutableDictionary *probeBarRow = [NSMutableDictionary dictionary]; [probeBarRow setObject:probeClass forKey:@"class"]; [probeBarRow setObject:[NSNumber numberWithBool:probeBar.translucent] forKey:@"translucent"]; [probeBarRow setObject:[NSNumber numberWithInteger:probeBar.behavioralStyle] forKey:@"behavioralStyle"]; [probeBarRow setObject:[NSNumber numberWithInteger:probeBar.preferredBehavioralStyle] forKey:@"preferredBehavioralStyle"]; [probeBarRow setObject:(probeBar.topItem.title ?: @"") forKey:@"title"]; NSMutableDictionary *probeStandardRow = [NSMutableDictionary dictionary]; [probeStandardRow setObject:(probeStandard.backgroundEffect ? (NSString *)NSStringFromClass([probeStandard.backgroundEffect class]) : @"none") forKey:@"backgroundEffect"]; [probeStandardRow setObject:(probeStandard.backgroundColor ? (NSString *)[probeStandard.backgroundColor description] : @"none") forKey:@"backgroundColor"]; [probeStandardRow setObject:(probeStandard.shadowColor ? (NSString *)[probeStandard.shadowColor description] : @"none") forKey:@"shadowColor"]; [probeStandardRow setObject:[NSNumber numberWithBool:probeStandard.backgroundImage != nil] forKey:@"hasBackgroundImage"]; [probeBarRow setObject:probeStandardRow forKey:@"standardAppearance"]; NSMutableDictionary *probeScrollEdgeRow = [NSMutableDictionary dictionary]; [probeScrollEdgeRow setObject:(probeScrollEdge.backgroundEffect ? (NSString *)NSStringFromClass([probeScrollEdge.backgroundEffect class]) : @"none") forKey:@"backgroundEffect"]; [probeScrollEdgeRow setObject:(probeScrollEdge.backgroundColor ? (NSString *)[probeScrollEdge.backgroundColor description] : @"none") forKey:@"backgroundColor"]; [probeScrollEdgeRow setObject:(probeScrollEdge.shadowColor ? (NSString *)[probeScrollEdge.shadowColor description] : @"none") forKey:@"shadowColor"]; [probeScrollEdgeRow setObject:[NSNumber numberWithBool:probeScrollEdge.backgroundImage != nil] forKey:@"hasBackgroundImage"]; [probeBarRow setObject:probeScrollEdgeRow forKey:@"scrollEdgeAppearance"]; [probeNavigationBars addObject:probeBarRow]; } if ([probeView isKindOfClass:[UIScrollView class]]) { UIScrollView *probeScroll = (UIScrollView *)probeView; NSMutableDictionary *probeScrollRow = [NSMutableDictionary dictionary]; [probeScrollRow setObject:probeClass forKey:@"class"]; [probeScrollRow setObject:(NSString *)NSStringFromCGPoint(probeScroll.contentOffset) forKey:@"contentOffset"]; [probeScrollRow setObject:(NSString *)NSStringFromUIEdgeInsets(probeScroll.contentInset) forKey:@"contentInset"]; [probeScrollRow setObject:(NSString *)NSStringFromUIEdgeInsets(probeScroll.adjustedContentInset) forKey:@"adjustedContentInset"]; if (@available(iOS 26.0, *)) { UIScrollEdgeEffectStyle *probeTopStyle = probeScroll.topEdgeEffect.style; UIScrollEdgeEffectStyle *probeBottomStyle = probeScroll.bottomEdgeEffect.style; NSString *probeTopName = probeTopStyle == UIScrollEdgeEffectStyle.softStyle ? @"soft" : probeTopStyle == UIScrollEdgeEffectStyle.hardStyle ? @"hard" : @"automatic"; NSString *probeBottomName = probeBottomStyle == UIScrollEdgeEffectStyle.softStyle ? @"soft" : probeBottomStyle == UIScrollEdgeEffectStyle.hardStyle ? @"hard" : @"automatic"; [probeScrollRow setObject:[NSNumber numberWithBool:probeScroll.topEdgeEffect.hidden] forKey:@"topEdgeHidden"]; [probeScrollRow setObject:[NSNumber numberWithBool:probeScroll.bottomEdgeEffect.hidden] forKey:@"bottomEdgeHidden"]; [probeScrollRow setObject:probeTopName forKey:@"topEdgeStyle"]; [probeScrollRow setObject:probeBottomName forKey:@"bottomEdgeStyle"]; } [probeScrollViews addObject:probeScrollRow]; } for (UIView *probeSubview in probeView.subviews) { [probeQueue addObject:probeSubview]; } } [probeReport setObject:probeViews forKey:@"relevantViews"]; [probeReport setObject:probeNavigationBars forKey:@"navigationBars"]; [probeReport setObject:probeScrollViews forKey:@"scrollViews"]; probeReport; })
detach
quit
